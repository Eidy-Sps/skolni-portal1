@model List<Skolni_portal.Data.Grade>

@{
    ViewData["Title"] = "Moje Známky";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold mb-2">
                <i class="bi bi-file-earmark-text text-primary"></i> Zadávání Známek
            </h1>
            <p class="text-muted">Spravujte známky svých žáků</p>
        </div>
    </div>

    <!-- Formulář pro přidání nové známky -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="bi bi-plus-circle me-2"></i> Nová Známka
                </div>
                <div class="card-body">
                    <form method="post" asp-action="AddGrade" class="row g-3">
                        <div class="col-md-3">
                            <label for="className" class="form-label">Třída</label>
                            <input type="text" class="form-control" id="className" name="className" placeholder="1.A" required />
                        </div>
                        <div class="col-md-3">
                            <label for="subject" class="form-label">Předmět</label>
                            <input type="text" class="form-control" id="subject" name="subject" placeholder="Matematika" required />
                        </div>
                        <div class="col-md-3">
                            <label for="studentEmail" class="form-label">Žák</label>
                            <select class="form-select" id="studentEmail" name="studentEmail" required>
                                <option selected disabled value="">-- Vyberte žáka --</option>
                                @if (ViewBag.Students != null)
                                {
                                    @foreach (var student in ViewBag.Students)
                                    {
                                        <option value="@student.Email">@student.Email</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="gradeValue" class="form-label">Známka (1-5)</label>
                            <select class="form-select" id="gradeValue" name="gradeValue" required>
                                <option selected disabled>Vyberte...</option>
                                <option value="1">1 - Výborně</option>
                                <option value="2">2 - Dobře</option>
                                <option value="3">3 - Průměrně</option>
                                <option value="4">4 - Slabě</option>
                                <option value="5">5 - Nedostatečně</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary fw-bold">
                                <i class="bi bi-check-circle me-2"></i> Zadat Známku
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabulka s vypsanými známkami -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-list-check me-2"></i> Přehled Zadaných Známek
                </div>
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Žák</th>
                                        <th>Třída</th>
                                        <th>Předmět</th>
                                        <th>Známka</th>
                                        <th>Zadáno</th>
                                        <th>Akce</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grade in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@(grade.Student?.Email ?? grade.StudentId)</strong>
                                            </td>
                                            <td>@grade.ClassName</td>
                                            <td>@grade.SubjectName</td>
                                            <td>
                                                <span class="badge bg-info">@grade.GradeValue</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@grade.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                <form method="post" asp-action="DeleteGrade" asp-route-id="@grade.Id" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Smazat tuto známku?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info m-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Dosud jste nezadali žádné známky.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>
