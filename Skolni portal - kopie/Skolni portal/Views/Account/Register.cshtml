@model Skolni_portal.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registrace";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-lg rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">Registrace</h2>
                        <p class="text-muted">Vytvoření účtu na školním portálu</p>
                    </div>

                    <form method="post" asp-action="Register">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-medium">Školní email</label>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="jmeno@spstrutnovska.cz" autofocus autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-medium">Heslo</label>
                            <input asp-for="Password" class="form-control form-control-lg" placeholder="Zadejte heslo" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-medium">Potvrzení hesla</label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Zadejte heslo znovu" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            <div class="form-text">Heslo musí obsahovat alespoň 6 znaků a 1 číslici.</div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsTeacher" class="form-check-input" id="isTeacher" />
                                <label asp-for="IsTeacher" class="form-check-label fw-medium">
                                    Registruji se jako učitel
                                </label>
                            </div>
                        </div>

                        <div class="mb-4" id="teacherCodeDiv" style="display: none;">
                            <label asp-for="TeacherCode" class="form-label fw-medium">Správní kód pro učitele</label>
                            <input asp-for="TeacherCode" class="form-control form-control-lg" placeholder="Zadejte správní kód" />
                            <span asp-validation-for="TeacherCode" class="text-danger small"></span>
                            <div class="form-text">Pouze učitelé mají přístup k tomuto kódu.</div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold mb-3 rounded-pill">
                            Zaregistrovat se
                        </button>
                    </form>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            Již máte účet? <a asp-action="Login" class="text-decoration-none">Přihlaste se</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('isTeacher').addEventListener('change', function() {
        const teacherCodeDiv = document.getElementById('teacherCodeDiv');
        if (this.checked) {
            teacherCodeDiv.style.display = 'block';
        } else {
            teacherCodeDiv.style.display = 'none';
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}