@model List<Skolni_portal.Data.Schedule>

@{
    ViewData["Title"] = "Můj Rozvrh";
    var dayNames = (string[])ViewBag.DayNames ?? new[] { "Pondělí", "Úterý", "Středa", "Čtvrtek", "Pátek" };
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold mb-2">
                <i class="bi bi-calendar-event text-success"></i> Můj Rozvrh Hodin
            </h1>
            <p class="text-muted">Týdenní rozvrh vašich hodin</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Přepínače dní v týdnu -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="btn-group w-100" role="group" id="daySelector">
                    <input type="radio" class="btn-check" name="dayOption" id="allDays" value="all" checked />
                    <label class="btn btn-outline-primary" for="allDays">Všechny dny</label>

                    @for (int i = 0; i < dayNames.Length; i++)
                    {
                        <input type="radio" class="btn-check" name="dayOption" id="day@i" value="@i" />
                        <label class="btn btn-outline-primary" for="day@i">@dayNames[i]</label>
                    }
                </div>
            </div>
        </div>

        <!-- Rozvrh - Všechny dny (default) -->
        <div id="allDaysView">
            @for (int dayOfWeek = 0; dayOfWeek < dayNames.Length; dayOfWeek++)
            {
                var daySchedules = Model.Where(s => s.DayOfWeek == dayOfWeek).ToList();

                <div class="row mb-4">
                    <div class="col-12">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-calendar-check"></i> @dayNames[dayOfWeek]
                        </h3>

                        @if (daySchedules.Any())
                        {
                            <div class="row g-3">
                                @foreach (var schedule in daySchedules.OrderBy(s => s.StartTime))
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card border-0 shadow-sm h-100 schedule-card">
                                            <div class="card-header bg-success text-white fw-bold">
                                                <i class="bi bi-clock me-2"></i>
                                                @schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")
                                            </div>
                                            <div class="card-body">
                                                <h5 class="card-title text-primary fw-bold mb-3">
                                                    @schedule.SubjectName
                                                </h5>
                                                <div class="mb-2">
                                                    <small class="text-muted d-block">
                                                        <i class="bi bi-person me-2"></i>
                                                        Učitel: <strong>@schedule.TeacherName</strong>
                                                    </small>
                                                </div>
                                                <div class="mb-2">
                                                    <small class="text-muted d-block">
                                                        <i class="bi bi-door-open me-2"></i>
                                                        Místnost: <strong>@schedule.Classroom</strong>
                                                    </small>
                                                </div>
                                                <div>
                                                    <small class="text-muted d-block">
                                                        <i class="bi bi-building me-2"></i>
                                                        Třída: <strong>@schedule.ClassName</strong>
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info" role="alert">
                                <i class="bi bi-info-circle me-2"></i>
                                V tento den nemáte žádné hodiny.
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Rozvrh - Jednotlivé dny (skryto) -->
        @for (int dayOfWeek = 0; dayOfWeek < dayNames.Length; dayOfWeek++)
        {
            var daySchedules = Model.Where(s => s.DayOfWeek == dayOfWeek).ToList();

            <div id="dayView@dayOfWeek" class="dayView" style="display: none;">
                <h3 class="fw-bold mb-3">
                    <i class="bi bi-calendar-check"></i> @dayNames[dayOfWeek]
                </h3>

                @if (daySchedules.Any())
                {
                    <div class="row g-3">
                        @foreach (var schedule in daySchedules.OrderBy(s => s.StartTime))
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-0 shadow-sm h-100 schedule-card">
                                    <div class="card-header bg-success text-white fw-bold">
                                        <i class="bi bi-clock me-2"></i>
                                        @schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")
                                    </div>
                                    <div class="card-body">
                                        <h5 class="card-title text-primary fw-bold mb-3">
                                            @schedule.SubjectName
                                        </h5>
                                        <div class="mb-2">
                                            <small class="text-muted d-block">
                                                <i class="bi bi-person me-2"></i>
                                                Učitel: <strong>@schedule.TeacherName</strong>
                                            </small>
                                        </div>
                                        <div class="mb-2">
                                            <small class="text-muted d-block">
                                                <i class="bi bi-door-open me-2"></i>
                                                Místnost: <strong>@schedule.Classroom</strong>
                                            </small>
                                        </div>
                                        <div>
                                            <small class="text-muted d-block">
                                                <i class="bi bi-building me-2"></i>
                                                Třída: <strong>@schedule.ClassName</strong>
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        V tento den nemáte žádné hodiny.
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Rozvrh hodin není v databázi dostupný. Prosím, kontaktujte správce.
        </div>
    }
</div>

<style>
    .schedule-card {
        transition: all 0.3s ease;
    }

    .schedule-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
    }

    .card-header {
        font-size: 0.95rem;
    }
</style>

<script>
    document.querySelectorAll('input[name="dayOption"]').forEach(radio => {
        radio.addEventListener('change', function() {
            // Skryj všechny dny
            document.querySelectorAll('.dayView').forEach(el => el.style.display = 'none');
            document.getElementById('allDaysView').style.display = 'none';

            // Zobraz vybraný den nebo všechny
            if (this.value === 'all') {
                document.getElementById('allDaysView').style.display = 'block';
            } else {
                document.getElementById('dayView' + this.value).style.display = 'block';
            }
        });
    });
</script>
