@model List<Skolni_portal.Data.Grade>

@{
    ViewData["Title"] = "Moje Známky";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold mb-2">
                <i class="bi bi-star text-warning"></i> Moje Známky
            </h1>
            <p class="text-muted">Přehled vašich akademických výsledků</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Statistika -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body text-center">
                        <h6 class="card-title text-muted">Celkem Známek</h6>
                        <h3 class="fw-bold text-primary">@Model.Count()</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body text-center">
                        <h6 class="card-title text-muted">Průměr</h6>
                        <h3 class="fw-bold text-success">
                            @string.Format("{0:F2}", Model.Average(g => g.GradeValue))
                        </h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body text-center">
                        <h6 class="card-title text-muted">Nejlepší</h6>
                        <h3 class="fw-bold text-info">@Model.Min(g => g.GradeValue)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body text-center">
                        <h6 class="card-title text-muted">Nejhorší</h6>
                        <h3 class="fw-bold text-danger">@Model.Max(g => g.GradeValue)</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabulka se známkami -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light fw-bold">
                        <i class="bi bi-list-check me-2"></i> Všechny Známky
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Předmět</th>
                                        <th>Třída</th>
                                        <th>Učitel</th>
                                        <th>Známka</th>
                                        <th>Zadáno</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grade in Model.OrderByDescending(g => g.CreatedAt))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@grade.SubjectName</strong>
                                            </td>
                                            <td>@grade.ClassName</td>
                                            <td>
                                                @if (grade.Teacher != null)
                                                {
                                                    <span>@grade.Teacher.Email</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Neznámý</span>
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    string gradeClass = grade.GradeValue == 1 ? "bg-success" :
                                                                      grade.GradeValue == 2 ? "bg-info" :
                                                                      grade.GradeValue == 3 ? "bg-warning" :
                                                                      grade.GradeValue == 4 ? "bg-warning" : "bg-danger";
                                                    string gradeText = grade.GradeValue == 1 ? "Výborně" :
                                                                      grade.GradeValue == 2 ? "Dobře" :
                                                                      grade.GradeValue == 3 ? "Průměrně" :
                                                                      grade.GradeValue == 4 ? "Slabě" : "Nedostatečně";
                                                }
                                                <span class="badge @gradeClass">@grade.GradeValue - @gradeText</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@grade.CreatedAt.ToString("dd.MM.yyyy")</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            Dosud jste neobdrželi žádné známky. Počkejte, až vám je zadají vaši učitelé.
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .card {
        border-radius: 10px;
    }
</style>
