@model List<ApplicationUser>
@{
    ViewData["Title"] = "Registrovaní učitelé";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Registrovaní učitelé</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Seznam učitelů (Celkem: @Model.Count)</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Uživatelské jméno</th>
                                <th>Registrován</th>
                                <th>Akce</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">Žádní učitelé nejsou registrováni</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var teacher in Model)
                                {
                                    <tr>
                                        <td>@teacher.Email</td>
                                        <td>@teacher.UserName</td>
                                        <td>@teacher.Id</td>
                                        <td>
                                            <form method="post" asp-action="RemoveTeacherRole" style="display: inline;">
                                                <input type="hidden" name="id" value="@teacher.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Opravdu chcete odebrat roli učitele?')">
                                                    Odebrat roli
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("TeacherCodes", "Admin")" class="btn btn-primary">Správa kódů</a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Zpět na domů</a>
            </div>
        </div>
    </div>
</div>
