                            {
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-header"><i class="bi bi-shield-lock me-2"></i>Administrace</li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="TeacherCodes"><i class="bi bi-key me-2"></i>Správa kódů učitelů</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Teachers"><i class="bi bi-people me-2"></i>Seznam učitelů</a></li>
