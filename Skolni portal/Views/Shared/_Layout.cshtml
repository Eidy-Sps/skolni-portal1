                            }
                            @if (!isTeacher && !isAdmin)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Student" asp-action="Schedule"><i class="bi bi-calendar-event me-2"></i>Můj Rozvrh</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-star me-2"></i>Moje Známky</a></li>
                            }
