<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SPŠ Trutnovská</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light-custom">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3 sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="bg-primary text-white rounded px-2 py-1 fs-6">SP</span>
                SPŠ Trutnovská
            </a>
            <div class="collapse navbar-collapse justify-content-center">
                <ul class="navbar-nav gap-3 fw-medium">
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="About">O škole</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Programs">Obory</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="News">Aktuality</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Contact">Kontakt</a></li>
                </ul>
            </div>
            <div>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-dark fw-bold rounded-pill px-4 dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i>@User.Identity?.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Můj panel</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i> Můj profil</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i> Nastavení</a></li>
                            @if (User.Identity?.Name?.Contains("admin") ?? false)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-header">Administrace</li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="TeacherCodes">Správa kódů učitelů</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Teachers">Seznam učitelů</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout" style="display:inline;">
                                    <button type="submit" class="dropdown-item text-danger">Odhlásit se</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary fw-bold rounded-pill px-4">Registrace</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark fw-bold rounded-pill px-4">Přihlásit se</a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <main class="container py-5">
        @RenderBody()
    </main>

    <footer class="bg-white border-top mt-5">
        <div class="container py-5">
            <div class="row g-4 mb-4">
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">SPŠ Trutnovská</h6>
                    <p class="text-muted small mb-0">
                        Moderní střední technická škola s tradicí. Připravujeme studenty na budoucnost v technických oborech.
                    </p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Navigace</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none small">O škole</a></li>
                        <li><a asp-controller="Home" asp-action="Programs" class="text-muted text-decoration-none small">Obory</a></li>
                        <li><a asp-controller="Home" asp-action="News" class="text-muted text-decoration-none small">Aktuality</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="text-muted text-decoration-none small">Kontakt</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Kontakt</h6>
                    <p class="text-muted small mb-1">
                        <i class="bi bi-telephone me-2"></i><a href="tel:+420499413999" class="text-muted text-decoration-none">+420 499 413 999</a>
                    </p>
                    <p class="text-muted small mb-1">
                        <i class="bi bi-envelope me-2"></i><a href="mailto:info@sps-trutnovska.cz" class="text-muted text-decoration-none">info@sps-trutnovska.cz</a>
                    </p>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-geo-alt me-2"></i>Av. Generála Svobody 1500, Trutnov
                    </p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Právní informace</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none small">Ochrana dat</a></li>
                        <li><a href="#" class="text-muted text-decoration-none small">Podmínky používání</a></li>
                        <li><a href="#" class="text-muted text-decoration-none small">Cookies</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-4">
            <div class="text-center">
                <p class="text-muted small mb-0">
                    &copy; 2024-2026 SPŠ Trutnovská. Všechna práva vyhrazena.
                </p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>