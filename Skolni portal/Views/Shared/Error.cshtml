@model ErrorViewModel
@{
    ViewData["Title"] = "Chyba";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <h1 class="display-1 fw-bold text-danger mb-3">Oops!</h1>
            <h2 class="text-dark mb-3">Při zpracování vaší žádosti došlo k chybě.</h2>
            <p class="text-muted fs-5 mb-4">
                Omlouváme se, ale něco se nepovedlo. Naši tým byl o tomto problému informován.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-info" role="alert">
                    <strong>ID žádosti:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex gap-2 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill">Zpět na úvodní stránku</a>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary btn-lg rounded-pill">Kontaktujte nás</a>
            </div>
        </div>
    </div>
</div>
