@model Skolni_portal.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registrace";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm p-4 rounded-4">
            <h2 class="text-center mb-3">Vytvořit účet</h2>
            <p class="text-center text-muted mb-4">SPŠ Trutnovská školní portál</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="control-label">Školní email</label>
                    <input asp-for="Email" class="form-control" placeholder="jmeno@spstrutnov.cz" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password" class="control-label">Heslo</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="ConfirmPassword" class="control-label">Potvrzení hesla</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form-group d-grid">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">Zaregistrovat se</button>
                </div>
            </form>
        </div>
    </div>
</div>