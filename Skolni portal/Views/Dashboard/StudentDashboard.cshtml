@{
    ViewData["Title"] = "Dashboard - Žák";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-left-info shadow-lg">
                <div class="card-body">
                    <h1 class="card-title fw-bold mb-2">Vítejte, @ViewData["UserName"]!</h1>
                    <p class="text-muted">Žákovský panel - @ViewData["UserEmail"]</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sekce Moje známky -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-star"></i> Moje známky
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Přehled vašich známek z jednotlivých předmětů.</p>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Předmět</th>
                                    <th>Průměr</th>
                                    <th>Stav</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="3" class="text-muted text-center">
                                        <small>Funkce je připravena pro implementaci.</small>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <a href="#" class="btn btn-sm btn-primary">Detaily</a>
                </div>
            </div>
        </div>

        <!-- Sekce Můj rozvrh -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar"></i> Můj rozvrh
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Přehled vašeho týdenního rozvrhu.</p>
                    <div class="alert alert-info">
                        <small>Funkce je připravena pro implementaci.</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-success">Zobrazit rozvrh</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sekce Absence -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-circle"></i> Moje absence
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Počet vašich absencí a omluvenek.</p>
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center">
                                <h4 class="text-danger">0</h4>
                                <small>Neomluvených</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <h4 class="text-success">0</h4>
                                <small>Omluvenek</small>
                            </div>
                        </div>
                    </div>
                    <a href="#" class="btn btn-sm btn-warning mt-3 w-100">Detaily absence</a>
                </div>
            </div>
        </div>

        <!-- Sekce Domácí úkoly -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-tasks"></i> Domácí úkoly
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Vaše zadané úkoly a lhůty.</p>
                    <div class="alert alert-info">
                        <small>Funkce je připravena pro implementaci.</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-info">Zobrazit úkoly</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-header {
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    }

    .card-header h5 {
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card {
        border: none;
        border-radius: 0.5rem;
    }

    .border-left-info {
        border-left: 0.25rem solid #17a2b8 !important;
    }
</style>
