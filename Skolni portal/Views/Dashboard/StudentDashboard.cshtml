@model Skolni_portal.Data.ApplicationUser
@{
    ViewData["Title"] = "Žákovský Panel";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-left-info shadow">
                <div class="card-body">
                    <div class="row">
                        <div class="col-auto">
                            <div class="text-info" style="font-size: 2.5rem;">
                                <i class="bi bi-mortarboard"></i>
                            </div>
                        </div>
                        <div class="col">
                            <h4 class="card-title fw-bold mb-0">Vítejte, @Model.UserName!</h4>
                            <p class="text-muted mb-0">Žákovský panel</p>
                            <small class="text-muted">Email: @Model.Email</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hlavní sekce -->
    <div class="row">
        <!-- Moje známky -->
        <div class="col-lg-6 col-md-12 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="mb-0">
                        <i class="bi bi-star-fill"></i> Moje známky
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted">Přehled vašich známek z jednotlivých předmětů</p>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Předmět</th>
                                    <th>Průměr</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="2" class="text-muted text-center py-3">
                                        <small><i class="bi bi-info-circle"></i> Čekání na data...</small>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary">
                        <i class="bi bi-arrow-right"></i> Detailní přehled
                    </button>
                </div>
            </div>
        </div>

        <!-- Můj rozvrh -->
        <div class="col-lg-6 col-md-12 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white py-3">
                    <h6 class="mb-0">
                        <i class="bi bi-calendar2-week"></i> Můj rozvrh
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted">Váš týdenní rozvrh hodin</p>
                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-info-circle"></i> Připraveno pro implementaci
                    </div>
                    <button type="button" class="btn btn-sm btn-success">
                        <i class="bi bi-arrow-right"></i> Zobrazit rozvrh
                    </button>
                </div>
            </div>
        </div>

        <!-- Moje absence -->
        <div class="col-lg-6 col-md-12 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-dark py-3">
                    <h6 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i> Moje absence
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted">Počet vašich absencí a omluvenek</p>
                    <div class="row g-3 my-2">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded text-center">
                                <h5 class="text-danger mb-1">0</h5>
                                <small class="text-muted">Neomluvené</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded text-center">
                                <h5 class="text-success mb-1">0</h5>
                                <small class="text-muted">Omluvenoké</small>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-warning w-100 mt-2">
                        <i class="bi bi-arrow-right"></i> Detaily absence
                    </button>
                </div>
            </div>
        </div>

        <!-- Domácí úkoly -->
        <div class="col-lg-6 col-md-12 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white py-3">
                    <h6 class="mb-0">
                        <i class="bi bi-list-task"></i> Domácí úkoly
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted">Vámi zadané úkoly a lhůty odevzdání</p>
                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-info-circle"></i> Připraveno pro implementaci
                    </div>
                    <button type="button" class="btn btn-sm btn-info">
                        <i class="bi bi-arrow-right"></i> Zobrazit úkoly
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistiky -->
    <div class="row mt-4">
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h5 class="text-primary">0</h5>
                    <p class="text-muted small mb-0">Průměr známek</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h5 class="text-warning">0</h5>
                    <p class="text-muted small mb-0">Hodin v rozvrhu</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h5 class="text-danger">0</h5>
                    <p class="text-muted small mb-0">Absencí</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h5 class="text-info">0</h5>
                    <p class="text-muted small mb-0">Aktivních úkolů</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-header {
        border-bottom: 1px solid rgba(0,0,0,0.125);
    }
    .border-left-info {
        border-left: 4px solid #0dcaf0 !important;
    }
</style>
