@{
    ViewData["Title"] = "Dashboard - Učitel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-left-primary shadow-lg">
                <div class="card-body">
                    <h1 class="card-title fw-bold mb-2">Vítejte, @ViewData["UserName"]!</h1>
                    <p class="text-muted">Učitelský panel - @ViewData["UserEmail"]</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sekce Třídy -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users"></i> Moje třídy
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Zde budou vaše přiřazené třídy.</p>
                    <div class="alert alert-info">
                        <small>Funkce je připravena pro implementaci.</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-primary">Spravovat třídy</a>
                </div>
            </div>
        </div>

        <!-- Sekce Známky -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-star"></i> Zadávání známek
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Spravujte známky vašich žáků.</p>
                    <div class="alert alert-info">
                        <small>Funkce je připravena pro implementaci.</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-success">Zadávat známky</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sekce Rozvrh -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar"></i> Můj rozvrh
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Přehled vašich hodin.</p>
                    <div class="alert alert-info">
                        <small>Funkce je připravena pro implementaci.</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-warning">Zobrazit rozvrh</a>
                </div>
            </div>
        </div>

        <!-- Sekce Absence -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-circle"></i> Absence žáků
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Sledujte absence v třídách.</p>
                    <div class="alert alert-info">
                        <small>Funkce je připravena pro implementaci.</small>
                    </div>
                    <a href="#" class="btn btn-sm btn-danger">Spravovat absence</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-header {
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    }

    .card-header h5 {
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card {
        border: none;
        border-radius: 0.5rem;
    }
</style>
